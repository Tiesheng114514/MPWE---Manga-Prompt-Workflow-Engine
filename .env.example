# AI 提示词 Agent 的 LLM API 配置（复制本文件为 .env 并填入真实 Key）
OPENAI_API_KEY=YOUR_API_KEY_HERE
# OPENAI_BASE_URL=https://api.deepseek.com
# MPWE_LLM_MODEL=deepseek-v4-flash
# MPWE_LLM_TIMEOUT=120

# 并行 ComfyUI 实例数（与 scripts/start_comfyui.bat 的 MPWE_COMFYUI_WORKERS 一致，
# 例如 2 = 127.0.0.1:8188,8189）；也可直接写逗号分隔的完整地址列表。
# MPWE_COMFYUI_WORKERS=2

# Cloudflare Turnstile 人机验证（注册页；Key 在 Cloudflare 控制台 Turnstile 页创建）
# TURNSTILE_SITE_KEY=0x4AAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
# TURNSTILE_ENABLED=true
